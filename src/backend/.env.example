# Copy to src/backend/.env  (cp .env.example src/backend/.env). Placeholders only - never commit real keys.

APP_ENV=development

# PostgreSQL + pgvector (the docker compose "db" service, or Cloud SQL). DATABASE_URL overrides the parts.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nsin
DB_USER=nsin
DB_PASSWORD=nsin-local-dev
# DATABASE_URL=postgresql://nsin:password@localhost:5433/nsin
# On Cloud Run: INSTANCE_CONNECTION_NAME=<project>:<region>:<instance>  (connects through the Cloud SQL socket)

# Google Gemini: free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the primary model is overloaded or retired
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Or Vertex AI with the Cloud Run service account instead of a key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=<project-id>
# GOOGLE_CLOUD_LOCATION=asia-south1
ENABLE_GEMINI_TRIAGE=true
ENABLE_VECTOR_SEARCH=true
ENABLE_LLM_BRIEFING=true
# Cost guards: cap on output tokens per Gemini call (includes thinking tokens), and a cache that
# reuses identical answers for this many seconds (0 = off).
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_CACHE_SECONDS=3600

# Live community map (Lucknow). DEMO_MODE lets staff dispatch a simulated responder for demos.
MAP_CITY=Lucknow
MAP_CENTER=26.8560,80.9800
DEMO_MODE=true
# Web app build only (frontend): a Google Maps key switches the map from MapLibre to Google Maps.
# Restrict the key to your site's HTTP referrers in the Cloud console. Passed as a docker build arg.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=

# Security & authentication
JWT_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
